# Cloudflare Pages: cabeceras de seguridad y caché
# Sin caché largo: el navegador siempre consulta si hay cambios (responde 304 si no hubo).
# Así lo que subas se ve enseguida, sin tocar números de versión.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: public, max-age=0, must-revalidate
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src 'none'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'

# Las fuentes casi nunca cambian (el nombre lleva versión: -v1, -v2…)
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Evitar que la copia en pages.dev compita con el dominio propio en Google
https://:project.pages.dev/*
  X-Robots-Tag: noindex
